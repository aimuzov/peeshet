{
	"name": "peeshet",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.11.1"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"start": "node src/main.ts",
		"dev": "node --watch --env-file-if-exists=.env src/main.ts",
		"test": "node --test 'src/**/*.test.ts'",
		"check": "tsc --noEmit",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:js": "oxlint --deny-warnings",
		"mcp": "node src/mcp/index.ts"
	},
	"dependencies": {
		"@grammyjs/runner": "2.0.3",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@sentry/node": "11.9.0",
		"grammy": "1.46.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "26.6.5",
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3"
	}
}
